# Copy this file to .env. Never commit real credentials.
# SERVER_ENV: dev, test, staging, prod, or production
SERVER_ENV=dev
WORLD_ID=1

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=dodian
DATABASE_TABLE_PREFIX=
DATABASE_USERNAME=dodian
DATABASE_PASSWORD=
DATABASE_INITIALIZE=false

CLIENT_VERSION=12
RSA_MODULUS=replace_with_your_rsa_modulus
RSA_EXPONENT=replace_with_your_rsa_private_exponent

# Discord OAuth (gates new account creation - see AccountLoginService/DiscordApiService).
# Leave DISCORD_ENABLED=false (or DISCORD_CLIENT_ID blank) to disable Discord-gated signup.
DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:8080/discord/callback
DISCORD_MAX_ACCOUNTS_PER_DISCORD=3
