# Copy this file to game-server/.env (dotenv-kotlin reads .env from the JVM working directory,
# which for Gradle/IDE runs of this module is game-server/, not the repo root). Never commit real
# credentials. All values below are optional - DotEnv.kt falls back to local-dev-safe defaults
# (including a committed dev-only RSA keypair) when unset, so the server, tests, and CI all boot
# without this file. Set real values here only to point at your own database or to use your own
# production RSA keypair/Discord credentials.
# SERVER_ENV: dev, test, staging, prod, or production
SERVER_ENV=dev
WORLD_ID=1

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=dodian
DATABASE_TABLE_PREFIX=
DATABASE_USERNAME=dodian
DATABASE_PASSWORD=
DATABASE_INITIALIZE=false

CLIENT_VERSION=13
# Leave unset to use the committed dev-only keypair in DotEnv.kt. Generate your own for production.
RSA_MODULUS=
RSA_EXPONENT=

# Discord OAuth (gates new account creation - see AccountLoginService/DiscordApiService).
# Leave DISCORD_ENABLED=false (or DISCORD_CLIENT_ID blank) to disable Discord-gated signup.
# DISCORD_REDIRECT_URL must exactly match game-client's Configuration.DiscordConfiguration.REDIRECT_URL
# and the redirect registered in the Discord Developer Portal - see docs/guides/discord_account_creation.md.
DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:8080
DISCORD_MAX_ACCOUNTS_PER_DISCORD=3

# Required to expose readiness, content manifests, Prometheus, metric history,
# and dashboards. When blank, operational routes return 404.
WEB_API_OPS_TOKEN=
